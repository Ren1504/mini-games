    "partyserver": "0.5.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261119.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
